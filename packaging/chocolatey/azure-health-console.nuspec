<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>azure-health-console</id>
    <version>@VERSION@</version>
    <title>Azure Health Console</title>
    <authors>Rafael Sonego da Silva</authors>
    <owners>RafaelSonego</owners>
    <projectUrl>https://github.com/RafaelSonego/azure-health-console</projectUrl>
    <projectSourceUrl>https://github.com/RafaelSonego/azure-health-console</projectSourceUrl>
    <bugTrackerUrl>https://github.com/RafaelSonego/azure-health-console/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/RafaelSonego/azure-health-console/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes>https://github.com/RafaelSonego/azure-health-console/releases/tag/v@VERSION@</releaseNotes>
    <tags>azure health monitoring triage cost security cli</tags>
    <summary>Read-only Azure health console: triage, dependencies, cost and security in a local page.</summary>
    <description>A local, read-only console for Azure: what's wrong now across your subscriptions, what a resource depends on and whether any of it is unhealthy, costs, security exposure and vulnerabilities, readiness before a busy period, and a summary to share. It reads with your own `az login` session and never changes anything in Azure.

Run `azure-health-console` after `az login`; it opens on 127.0.0.1 in your browser.</description>
    <dependencies>
      <dependency id="azure-cli" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
